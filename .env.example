# =============================================================
# Liraydhas — environment variables
#
# Copy to .env.local for local dev. In production (Vercel), set
# these in Project Settings → Environment Variables.
# =============================================================

# --- Required: LLM daily readings -----------------------------
# Get one at https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...

# Optional: override the Claude model used for the daily reading.
# ANTHROPIC_MODEL=claude-sonnet-4-6

# --- Optional: Push notifications -----------------------------
# Generate the VAPID pair once with:
#   npm run vapid -- you@example.com
# then paste the three output lines below.
#
# VAPID_SUBJECT must be a mailto: URL or https: URL identifying
# you to push providers in case of abuse reports.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Vercel sets CRON_SECRET automatically for projects with a
# vercel.json `crons:` block. The /api/cron/daily-reading route
# refuses to send without it (so an open cron endpoint can't be
# abused). For local cron testing set any string here and pass it
# as `Authorization: Bearer <secret>` when curling the endpoint.
CRON_SECRET=

# --- Optional: Persistent push-subscription storage -----------
# Without these, subscriptions live in the serverless function's
# in-memory Map — fine for local dev, lost on every cold start in
# production. Enable Vercel KV in your project's Storage tab and
# Vercel will inject these automatically.
KV_REST_API_URL=
KV_REST_API_TOKEN=
