# =============================================================
# Liraydhas — environment variables
#
# Copy to .env.local for local dev. In production (Vercel), set
# these in Project Settings → Environment Variables.
# =============================================================

# --- Required: LLM daily readings -----------------------------
# Get one at https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...

# Optional: override the Claude model used for the daily reading.
# ANTHROPIC_MODEL=claude-sonnet-4-6

# --- Optional: Push notifications -----------------------------
# Generate the VAPID pair once with:
#   npm run vapid -- you@example.com
# then paste the three output lines below.
#
# VAPID_SUBJECT must be a mailto: URL or https: URL identifying
# you to push providers in case of abuse reports.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Vercel sets CRON_SECRET automatically for projects with a
# vercel.json `crons:` block. The /api/cron/daily-reading route
# refuses to send without it (so an open cron endpoint can't be
# abused). For local cron testing set any string here and pass it
# as `Authorization: Bearer <secret>` when curling the endpoint.
CRON_SECRET=

# --- Optional: Persistent push-subscription storage -----------
# Without these, subscriptions live in the serverless function's
# in-memory Map — fine for local dev, lost on every cold start in
# production. Enable Vercel KV in your project's Storage tab and
# Vercel will inject these automatically.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# --- Optional: APNs for the iOS App Store build ---------------
# Web push (VAPID above) works in browsers + installed PWAs but
# does NOT work for apps shipped via the App Store. Those run in
# a Capacitor WKWebView shell and need APNs directly.
#
# One-time Apple Developer setup:
#  1. Apple Developer → Certificates, Identifiers & Profiles → Keys.
#  2. Create a new key, enable "Apple Push Notifications service (APNs)",
#     download the .p8 file (only chance — save it!).
#  3. Note the Key ID (next to the key name) and your Team ID
#     (top-right of the Apple Developer site).
#  4. Xcode → your project → Signing & Capabilities → "+" →
#     add "Push Notifications" capability.
#
# Paste the values below:
APNS_KEY_ID=                # 10 chars from Apple Developer
APNS_TEAM_ID=               # 10 chars, your team
APNS_BUNDLE_ID=             # e.g. com.liraydhas.app — must match Xcode
APNS_ENVIRONMENT=production # or "development" for Xcode debug builds
# Paste the entire .p8 file on ONE line with literal \n for newlines:
#   APNS_KEY_P8="-----BEGIN PRIVATE KEY-----\nMIG...\n-----END PRIVATE KEY-----"
APNS_KEY_P8=
